# ENGINPILOT THERM-NET | Local Development Environment

# Kafka Broker Connection
# For local Docker Compose, this will later be overridden to 'kafka:29092'
KAFKA_BOOTSTRAP_SERVERS=localhost:9092

# Topic Configuration
KAFKA_RAW_TELEMETRY_TOPIC_NAME=telemetry_raw
KAFKA_PREDICTED_TOPIC_NAME=telemetry_predicted

# Consumer Group (Must be unique to this worker scaling group)
KAFKA_CONSUMER_GROUP_ID=physics-worker-group